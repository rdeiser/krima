<GrimaForm>
	<Title>Grima: Login</Title>
	<Field
		name="username"
		label="Username:"
		autocomplete="on"
		required="yes"
		placeholder="Your GRIMA ID..."
		value="Production"
		type="hidden"
	/>
	<Field
		name="password"
		label="Password:"
		autocomplete="off"
		required="yes"
		placeholder="Your GRIMA password..."
		value="Production"
		type="hidden"
	/>
	<Field
		name="institution"
		label="Institution:"
		required="yes"
		type="select"
	>
		<option
		value="">Choose API Key</option>
		<option value="Production">Production</option>
		<option value="Sandbox">Sandbox</option>
	</Field>
	<Field
		name="redirect_url"
		type="hidden"
		required="no"
	/>
</GrimaForm>